{
  "name": "shirim-chords",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write src e2e"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "prettier": "^3.3.3",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
